{
    "name": "little-durable",
    "version": "0.1.1",
    "description": "A lightweight durable workflow runtime for TypeScript.",
    "type": "module",
    "license": "MIT",
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.5.0",
    "keywords": [
        "durable-execution",
        "durable-workflows",
        "journal",
        "typescript",
        "workflow"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TerseAI/little-durable.git"
    },
    "homepage": "https://github.com/TerseAI/little-durable#readme",
    "bugs": {
        "url": "https://github.com/TerseAI/little-durable/issues"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "check": "pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
        "prepublishOnly": "pnpm run check"
    },
    "dependencies": {
        "ms": "2.1.3",
        "ulid": "3.0.2"
    },
    "peerDependencies": {
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/ms": "^2.1.0",
        "@types/node": "^22.0.0",
        "prettier": "^3.8.1",
        "typescript": "^5.0.0",
        "vitest": "^3.2.6",
        "zod": "^4.3.6"
    }
}
